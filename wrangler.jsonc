{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relay-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayConversationAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RelayChatAgent"],
      "deleted_classes": ["RelayConversationAgent"]
    }
  ],
  "env": {
    "staging": {
      "name": "relay-agent-starter-staging",
      "secrets": {
        "required": [
          "RELAY_AGENT_TOKEN",
          "RELAY_WEBHOOK_SECRET"
        ]
      },
      "vars": {
        "RELAY_API_ORIGIN": "https://api.staging.relayapp.im"
      },
      // One isolated Durable Object namespace per environment. Every verified
      // event is committed before the webhook receives a 2xx.
      "durable_objects": {
        "bindings": [
          {
            "name": "RelayChat",
            "class_name": "RelayChatAgent"
          }
        ]
      }
    },
    "production": {
      "name": "relay-agent",
      "secrets": {
        "required": [
          "RELAY_AGENT_TOKEN",
          "RELAY_WEBHOOK_SECRET"
        ]
      },
      "vars": {
        "RELAY_API_ORIGIN": "https://api.relayapp.im"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "RelayChat",
            "class_name": "RelayChatAgent"
          }
        ]
      }
    }
  }
}
