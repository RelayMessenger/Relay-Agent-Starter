{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tanias-pizza-agent-development",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": [
      "RELAY_AGENT_TOKEN",
      "RELAY_WEBHOOK_SECRET"
    ]
  },
  "vars": {
    "MODEL_ID": "@cf/zai-org/glm-5.3-flash",
    "RELAY_INTERACTIVE_PARTS": "true",
    "RELAY_AGENT_HANDLE": "taniaspizza",
    "RELAY_API_ORIGIN": "https://api.staging.relayapp.im",
    "CAL_EVENT_TYPE_ID": "",
    "TOAST_RESTAURANT_GUID": ""
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "SENDER_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RelayChat",
        "class_name": "RelayChatAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayConversationAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RelayChatAgent"],
      "deleted_classes": ["RelayConversationAgent"]
    }
  ],
  "env": {
    "staging": {
      "name": "tanias-pizza-agent-staging",
      "secrets": {
        "required": [
          "RELAY_AGENT_TOKEN",
          "RELAY_WEBHOOK_SECRET"
        ]
      },
      "vars": {
        "MODEL_ID": "@cf/zai-org/glm-5.3-flash",
        "RELAY_INTERACTIVE_PARTS": "true",
        "RELAY_AGENT_HANDLE": "taniaspizza",
        "RELAY_API_ORIGIN": "https://api.staging.relayapp.im",
        "CAL_EVENT_TYPE_ID": "7215538",
        "TOAST_RESTAURANT_GUID": ""
      },
      "ai": {
        "binding": "AI"
      },
      "ratelimits": [
        {
          "name": "SENDER_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 20, "period": 60 }
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "RelayChat",
            "class_name": "RelayChatAgent"
          }
        ]
      }
    },
    "production": {
      "name": "tanias-pizza-agent",
      "secrets": {
        "required": [
          "RELAY_AGENT_TOKEN",
          "RELAY_WEBHOOK_SECRET"
        ]
      },
      "vars": {
        "MODEL_ID": "@cf/zai-org/glm-5.3-flash",
        "RELAY_INTERACTIVE_PARTS": "false",
        "RELAY_AGENT_HANDLE": "taniaspizza",
        "RELAY_API_ORIGIN": "https://api.relayapp.im",
        "CAL_EVENT_TYPE_ID": "",
        "TOAST_RESTAURANT_GUID": ""
      },
      "ai": {
        "binding": "AI"
      },
      "ratelimits": [
        {
          "name": "SENDER_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 20, "period": 60 }
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "RelayChat",
            "class_name": "RelayChatAgent"
          }
        ]
      }
    }
  }
}
