{
  "name": "tanias-pizza-agent",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Tania's Pizza agent for Relay Messenger, built on Cloudflare Think.",
  "keywords": [
    "relay",
    "cloudflare",
    "think",
    "messenger",
    "webhook",
    "ai-agent"
  ],
  "homepage": "https://github.com/RelayMessenger/Relay-Agent-Starter#readme",
  "bugs": {
    "url": "https://github.com/RelayMessenger/Relay-Agent-Starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RelayMessenger/Relay-Agent-Starter.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "wrangler dev --env staging",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "deploy:production": "node scripts/deploy.mjs production",
    "dry-run": "npm run dry-run:default && npm run dry-run:staging && npm run dry-run:production",
    "dry-run:default": "wrangler deploy --dry-run",
    "dry-run:staging": "wrangler deploy --env staging --dry-run",
    "dry-run:production": "wrangler deploy --env production --dry-run",
    "types": "wrangler types --env staging",
    "types:check": "wrangler types --env staging --check",
    "check": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:workerd",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:workerd": "vitest run --config vitest.workerd.config.ts",
    "test:installed": "node scripts/test-installed-template.mjs",
    "test:all": "npm run types:check && npm run check && npm test && npm run test:installed && npm run dry-run",
    "eval": "vitest run --config vitest.eval.config.ts"
  },
  "dependencies": {
    "@cloudflare/think": "0.19.0",
    "@relaymessenger/chat-sdk-adapter": "0.3.7-staging.20",
    "@relaymessenger/sdk": "0.3.6-staging.26",
    "agents": "0.24.0",
    "ai": "7.0.107",
    "chat": "4.41.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "3.0.41",
    "@cloudflare/vitest-plugin": "1.1.13",
    "@types/node": "22.18.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.135.0"
  },
  "cloudflare": {
    "label": "Tania's Pizza Relay Agent",
    "products": [
      "Workers",
      "Workers AI",
      "Durable Objects"
    ],
    "categories": [
      "ai"
    ],
    "docs_url": "https://docs.relayapp.im/integrations/cloudflare",
    "bindings": {
      "RELAY_AGENT_TOKEN": {
        "description": "Agent Token from Relay Console. Relay shows it once."
      },
      "RELAY_WEBHOOK_SECRET": {
        "description": "Signing secret returned when this Worker's Relay webhook subscription is created. Relay shows it once."
      }
    }
  }
}
