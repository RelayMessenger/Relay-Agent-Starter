{
  "name": "relay-agent-starter",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Minimal Cloudflare Think starter for a Relay Messenger agent.",
  "keywords": [
    "relay",
    "cloudflare",
    "think",
    "messenger",
    "webhook",
    "ai-agent"
  ],
  "homepage": "https://github.com/RelayMessenger/Relay-Agent-Starter#readme",
  "bugs": {
    "url": "https://github.com/RelayMessenger/Relay-Agent-Starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RelayMessenger/Relay-Agent-Starter.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "deploy:production": "node scripts/deploy.mjs production",
    "dry-run": "npm run dry-run:default && npm run dry-run:production",
    "dry-run:default": "wrangler deploy --dry-run",
    "dry-run:production": "wrangler deploy --env production --dry-run",
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "check": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:workerd",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:workerd": "vitest run --config vitest.workerd.config.ts",
    "test:installed": "node scripts/test-installed-template.mjs",
    "test:all": "npm run types:check && npm run check && npm test && npm run test:installed && npm run dry-run"
  },
  "dependencies": {
    "@cloudflare/think": "0.20.1",
    "@relaymessenger/chat-sdk-adapter": "^0.3.13",
    "@relaymessenger/think": "^0.1.4",
    "agents": "0.27.0",
    "ai": "7.0.131",
    "chat": "4.41.0",
    "zod": "4.6.5"
  },
  "//": [
    "agents 0.28.0 still pins vulnerable MCP peers. Remove the scoped override when upstream fixes https://github.com/advisories/GHSA-6qxp-vccf-f47h",
    "guarded-fetch 0.1.3 pins undici 7.29.0. Patch its copy for https://github.com/advisories/GHSA-rfgv-xxqx-mfg5 and https://github.com/advisories/GHSA-w293-vg96-wgc3"
  ],
  "overrides": {
    "agents@0.27.0": {
      "@modelcontextprotocol/sdk": "1.31.0",
      "@modelcontextprotocol/client": "2.2.0"
    },
    "guarded-fetch@0.1.3": {
      "undici": "7.29.1"
    }
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.7",
    "@types/node": "22.18.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.148.0"
  },
  "cloudflare": {
    "label": "Relay Think Agent",
    "products": [
      "Workers",
      "Workers AI",
      "Durable Objects"
    ],
    "categories": [
      "ai"
    ],
    "docs_url": "https://docs.relayapp.im/integrations/cloudflare",
    "bindings": {
      "RELAY_AGENT_TOKEN": {
        "description": "Agent Token from Relay Console. Relay shows it once."
      },
      "RELAY_WEBHOOK_SECRET": {
        "description": "Signing secret returned when this Worker's Relay webhook subscription is created. Relay shows it once."
      }
    }
  }
}
